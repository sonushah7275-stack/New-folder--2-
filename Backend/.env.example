PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/tejova
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=30d

# Frontend URLs for CORS & Cookies
CLIENT_URL=https://new-folder-2-tejova.onrender.com
ADMIN_URL=https://tejova-admin-dashboard.onrender.com
FRONTEND_URL=https://new-folder-2-tejova.onrender.com
ADMIN_FRONTEND_URL=https://tejova-admin-dashboard.onrender.com

# Initial Admin Credentials
ADMIN_EMAIL=admin12@tejova.com
ADMIN_PASSWORD=your_secure_admin_password

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
